@{
    ViewData["Title"] = "Employee Registration";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="upload-page">
    <div class="upload-container">
        <h1 class="upload-title">Employee Registration</h1>
        <p class="upload-subtitle">Create employee accounts that can access the Enterprise AI Bot.</p>

        <div id="employee-register-success" class="success-banner" hidden></div>
        <div id="employee-register-error" class="error-banner" hidden></div>

        <form id="employee-register-form" class="auth-form" autocomplete="off">
            @Html.AntiForgeryToken()

            <div class="form-group">
                <label for="employee-id">Employee ID</label>
                <input id="employee-id" name="employeeId" type="text" required maxlength="30" />
            </div>

            <div class="form-group">
                <label for="employee-full-name">Full Name</label>
                <input id="employee-full-name" name="fullName" type="text" required maxlength="100" />
            </div>

            <div class="form-group">
                <label for="employee-email">Email</label>
                <input id="employee-email" name="email" type="email" required />
            </div>

            <div class="form-group">
                <label for="employee-department">Department</label>
                <input id="employee-department" name="department" type="text" required maxlength="100" />
            </div>

            <div class="form-group">
                <label for="employee-role">Role</label>
                <input id="employee-role" name="role" type="text" value="Employee" required maxlength="50" />
            </div>

            <div class="form-group">
                <label for="employee-password">Password</label>
                <input id="employee-password" name="password" type="password" required minlength="8" />
            </div>

            <div class="form-group">
                <label for="employee-confirm-password">Confirm Password</label>
                <input id="employee-confirm-password" name="confirmPassword" type="password" required minlength="8" />
            </div>

            <button type="submit" id="btn-register-employee" class="btn-primary">Register</button>
        </form>
    </div>
</div>
